    "benchmark": "npx ts-node -r ./scripts/register-paths.ts scripts/index-benchmark.ts",
    "fix-labels": "npx ts-node -r ./scripts/register-paths.ts scripts/fix-labels.ts",
    "parse-niort": "npx ts-node -r ./scripts/register-paths.ts scripts/parse-casestudy.ts niort 36f5a334-4611-4da3-81c0-a7ec8d600a59 production tunnel",
    "typecheck": "tsc --noEmit"

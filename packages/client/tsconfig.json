{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": false,
    "incremental": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "outDir": "./dist/",
    "paths": {
      "api": ["./src/api"],
      "app": ["./src/app"],
      "ensure-basename": ["./src/ensure-basename"],
      "components": ["./src/components"],
      "components/*": ["./src/components/*"],
      "hooks": ["./src/hooks"],
      "hooks/*": ["./src/hooks/*"],
      "pages": ["./src/pages"],
      "pages/*": ["./src/pages/*"],
      "redux/store": ["./src/redux/store"],
      "redux/hooks": ["./src/redux/hooks"],
      "redux/features/*": ["./src/redux/features/*"],
      "Theme": ["./src/Theme"],
      "Theme/*": ["./src/Theme/*"],
      "utils": ["./src/utils"],
      "utils/*": ["./src/utils/*"],
      "constructors": ["./src/constructors"],
      "constructors/*": ["./src/constructors/*"],
      "types": ["./src/types"],
      "types/*": ["./src/types/*"],
      "assets": ["./src/assets"],
      "assets/*": ["./src/assets/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "esnext",
    "types": ["node", "vite/client"]
  },
  "exclude": ["node_modules", "dist", "public"],
  "include": [
    "styled.d.ts",
    "types.d.ts",
    "images.d.ts",
    "css.d.ts",
    "fonts.d.ts",
    "vitest.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}

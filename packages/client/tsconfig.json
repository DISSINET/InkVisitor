{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": false,
    "incremental": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "outDir": "./dist/",
    "paths": {
      "@dictionaries": ["./../../shared/dictionaries/index.ts"],
      "@shared/*": ["./../../shared/*"],
      "api": ["./api"],
      "components": ["./components"],
      "hooks": ["./hooks"],
      "pages": ["./pages"],
      "redux/store": ["./redux/store"],
      "redux/hooks": ["./redux/hooks"],
      "redux/features/*": ["./redux/features/*"],
      "Theme": ["./Theme"],
      "app": ["./app"],
      "ensure-basename": ["./ensure-basename"],
      "utils": ["./utils"],
      "constructors": ["./constructors"],
      "types": ["./types"],
      "assets": ["./assets"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "esnext"
  },
  "exclude": ["node_modules", "dist", "public"],
  "include": [
    "types.d.ts",
    "images.d.ts",
    "fonts.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}

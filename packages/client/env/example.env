# Optional instance id override (defaults to the vite build mode, e.g. sandbox).
# Do not set NODE_ENV here — vite sets it automatically.
ENV=

# Assets - used for setting the base path in case your app is available under some non-root path
ROOT_URL=

# Api - url of api base
APIURL=

# HGA-Engine - base url of the historical geocoding service that backs the
# Geocoding page. Deployment infrastructure, not a project setting: the page
# posts place names and records researcher choices to whatever this addresses.
# Left unreachable, the Geocoding page still lists, filters and accepts a
# coordinate set by clicking the map; only engine-driven suggestions are off.
HGA_ENGINE_URL=http://localhost:30005

# contact email
ADMIN_MAIL="admin@inkvisitor.cz"

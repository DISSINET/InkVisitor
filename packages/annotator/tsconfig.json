{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src/lib",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2018",
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"],
  "include": ["src/lib/**/*.ts"]
}

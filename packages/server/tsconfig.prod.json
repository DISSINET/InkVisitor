{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "..",
    "skipLibCheck": true,
    "incremental": true
  },
  "files": [
    "./src/custom_typings/request.d.ts",
    "./src/custom_typings/dotenv.d.ts"
  ],
  "include": ["./src/**/*.ts"],
  "exclude": [
    "./src/public/",
    "./src/test/",
    "./src/**/*.test.ts",
    "node_modules",
    "dist"
  ]
}

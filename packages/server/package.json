{
  "name": "inkvisitor-server",
  "version": "1.5.3",
  "engines": {
    "node": "^22.13.1",
    "pnpm": "^11.1.2"
  },
  "scripts": {
    "lint": "tslint --project \"tsconfig.json\"",
    "test": "jest -w 1 -t",
    "start": "ENV_FILE=development nodemon",
    "dev": "ENV_FILE=development nodemon",
    "build": "tsgo --build tsconfig.prod.json",
    "typecheck": "tsgo --noEmit",
    "start:dist": "node -r module-alias/register ./dist/server/src",
    "hashpassword": "ENV_FILE=test ts-node -r ./src/register-paths.ts ./src/scripts/hashpassword.ts"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "../shared/dist"
    ],
    "ext": "ts, html",
    "ignore": [
      "src/public"
    ],
    "exec": "ts-node -r ./src/register-paths.ts ./src"
  },
  "_moduleAliases": {
    "@common": "dist/server/src/common",
    "@modules": "dist/server/src/modules",
    "@service": "dist/server/src/service",
    "@models": "dist/server/src/models",
    "@middlewares": "dist/server/src/middlewares"
  },
  "dependencies": {
    "@inkvisitor/shared": "workspace:*",
    "@types/cli-color": "^2.0.2",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "cli-color": "^2.0.3",
    "compression": "^1.7.4",
    "connect-timeout": "^1.9.0",
    "cookie-parser": "^1.4.7",
    "cookie-signature": "^1.2.2",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.20.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.19.0",
    "generic-pool": "^3.9.0",
    "helmet": "^3.23.1",
    "http": "0.0.1-security",
    "http-status-codes": "^1.4.0",
    "https": "^1.0.0",
    "module-alias": "^2.2.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.16",
    "randomstring": "^1.1.5",
    "rethinkdb-ts": "^2.4.18",
    "socket.io": "^4.7.5",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^3.9.0",
    "tslib": "^2.7.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.2",
    "@types/connect-timeout": "^0.0.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-signature": "^1.1.2",
    "@types/cors": "^2.8.6",
    "@types/dotenv": "^8.2.3",
    "@types/email-templates": "^8.0.4",
    "@types/express": "^4.17.6",
    "@types/express-session": "^1.19.0",
    "@types/helmet": "0.0.47",
    "@types/jest": "29.5.12",
    "@types/morgan": "^1.9.1",
    "@types/node": "^14.0.13",
    "@types/nodemailer": "^6.4.17",
    "@types/randomstring": "^1.1.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.1.0",
    "@typescript-eslint/parser": "^5.0.1",
    "@typescript/native-preview": "beta",
    "eslint": "^8.14.0",
    "jest": "29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^2.6.2",
    "rsync": "^0.6.1",
    "supertest": "^7.2.2",
    "ts-jest": "29.1.5",
    "tslint": "^6.1.2",
    "tslint-lines-between-class-members": "^1.3.6",
    "typescript": "npm:@typescript/typescript6@^6.0.0"
  }
}

# Environment - used for identyfing the environment
NODE_ENV=test

# identify the instance - ie. for emails
DOMAIN=dissinet.cz

# path to client files served by the server
STATIC_PATH=/apps/inkvisitor-development

# directory containing the DB backup archives, mounted read-only from the inkvisitor-backup PVC (empty/unset = backups API disabled)
BACKUP_DIR=/backup

# serving swagger file from file (empty to disable), ie. ./swagger.json
SWAGGER_FILE=

PORT=3000

# Flag for enabling SSL - loads cert.pem & key.pem from 'secret' dir
HTTPS=0

# Database
# WARNING: when this env is used for the test suite (env/.env.test), DB_NAME
# MUST be a disposable test database (e.g. inkvisitor_test). The tests wipe
# whole tables; src/service/shorthands.ts refuses to run the wipe helpers
# unless DB_NAME matches a test pattern (*_test, iv_test_*, test_*).
DB_PORT=28015
DB_HOST=localhost
DB_NAME=inkvisitor
DB_AUTH=''
DB_POOL_CONNECTIONS=10

# For signing jwt token
SECRET=123456789

# Mails - SMTP (e.g. Mailjet: host in-v3.mailjet.com, user=api key, secret=secret key)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_SECRET=
MAILER_SENDER=

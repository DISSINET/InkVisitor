# Environment - used for identyfing the environment
NODE_ENV=test

# Instance id - must be unique per deployment on the same domain (session cookie
# name is derived from this). Must match the client build mode for that instance
# (e.g. server ENV=sandbox + client built with pnpm build:sandbox).
ENV=inkvisitor-development

# identify the instance - ie. for emails
DOMAIN=dissinet.cz

# path to client files served by the server
STATIC_PATH=/apps/inkvisitor-development

# directory containing the DB backup archives, mounted read-only from the inkvisitor-backup PVC (empty/unset = backups API disabled)
BACKUP_DIR=/backup

# serving swagger file from file (empty to disable), ie. ./swagger.json
SWAGGER_FILE=

# Log "Slow query(<ms>): <route>" lines for requests over 200ms.
# Enabled unless set to 0/false/no/off (unset = enabled).
LOG_SLOW_QUERIES=

PORT=3000

# Flag for enabling SSL - loads cert.pem & key.pem from 'secret' dir
HTTPS=0

# Reverse-proxy hop count between the client and this process. Required when a
# proxy terminates TLS: without it req.secure stays false, express-session drops
# the Secure session cookie, and the signin rate limit keys everyone to the
# proxy's IP. Default: 1 when NODE_ENV=production, otherwise off.
# Positive integer, or "false"/"0" to trust nothing. Never set this to "true".
TRUST_PROXY=

# Database
# WARNING: when this env is used for the test suite (env/.env.test), DB_NAME
# MUST be a disposable test database (e.g. inkvisitor_test). The tests wipe
# whole tables; src/service/shorthands.ts refuses to run the wipe helpers
# unless DB_NAME matches a test pattern (*_test, iv_test_*, test_*).
DB_PORT=28015
DB_HOST=localhost
DB_NAME=inkvisitor
DB_AUTH=''
DB_POOL_CONNECTIONS=10
# Storage backend: rethinkdb (default) or postgres (#3256). DB_NAME names the
# database on either backend; the PostgreSQL connection is the PG_* block below.
DB_ADAPTER=

# For signing session cookies and short-lived download tokens
SECRET=123456789

# Optional session settings
SESSION_MAX_AGE=2592000000
# Override cookie name (default: inkvisitor.sid.<ENV>)
SESSION_COOKIE_NAME=
# lax (default) | strict | none
SESSION_COOKIE_SAMESITE=lax
# Comma-separated allowed browser origins (default: derived from DOMAIN)
CORS_ORIGINS=

# Mails - SMTP (e.g. Mailjet: host in-v3.mailjet.com, user=api key, secret=secret key)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_SECRET=
MAILER_SENDER=

# PostgreSQL (#3256 storage migration). Used when DB_ADAPTER=postgres.
# Matches the `postgres` service in docker-compose.yml. PG_NAME there names
# the database the container creates; the server names its database with
# DB_NAME on both backends.
PG_HOST=localhost
PG_PORT=5432
PG_USER=inkvisitor
PG_PASS=inkvisitor

# HGA-Engine - base url of the historical geocoding service behind the Geocoding
# page. Deployment infrastructure, not a project setting. Left blank, the page
# still lists, filters and accepts a coordinate set on the map; only
# engine-driven suggestions are off.
HGA_ENGINE_URL=
# Only for an engine that requires a key. Server-side secret, sent as a bearer
# token on every forwarded request.
HGA_ENGINE_API_KEY=

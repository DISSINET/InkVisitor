{
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": false,
    "incremental": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "build",
    "paths": {
      "src/*": ["./src/*"],
      "@common/*": ["./src/common/*"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@models/*": ["./src/models/*"],
      "@modules/*": ["./src/modules/*"],
      "@service/*": ["./src/service/*"],
      "@inkvisitor/shared/*": ["./../shared/*"]
    },
    "removeComments": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es6",
    "typeRoots": ["node_modules/@types"],
    "types": ["node", "jest"]
  },
  "exclude": ["./src/public/", "node_modules", "build"],
  "files": [
    "./src/custom_typings/request.d.ts",
    "./src/custom_typings/dotenv.d.ts"
  ],
  "include": ["./src/**/*.ts"],
  "ts-node": {
    "files": true
  }
}
